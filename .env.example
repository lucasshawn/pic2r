# Cloudflare R2 Configuration for Netlify Functions
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=picture-catalog
R2_PUBLIC_DOMAIN=https://pub-xxxxxx.r2.dev

# Google Auth & Read-Only Admin Configuration
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_ADMIN_EMAILS=admin@example.com,user@example.com

